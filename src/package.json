  "dependencies": {
    "@seald-io/nedb": "^4.1.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-vue-next": "^1.0.0",
    "swagger-ui-express": "^5.0.1",
    "vite": "^8.3.0",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2"
  }
