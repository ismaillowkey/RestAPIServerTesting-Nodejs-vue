{
  "name": "nodejs-vue-restapi-server",
  "version": "1.0.0",
  "description": "Unified Node.js, Vue 3, and SQLite REST API Server in a single port",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev": "node server/index.js",
    "build": "node scripts/build.js",
    "package:portable": "node scripts/package-portable.js",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "seed": "node server/seed.js"
